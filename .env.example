# GitHub personal access token, read-only public repo scope.
# Raises the API limit from 60 to 5000 requests/hour. Leave empty for anonymous use.
GITHUB_TOKEN=

# SQLite database file (relative to services/analyzer)
DATABASE_URL=sqlite:///./data/codemri.db

# API host/port for local development
API_HOST=127.0.0.1
API_PORT=8000

# Safety limits
MAX_REPO_SIZE_MB=150
MAX_FILES=20000
MAX_FILE_SIZE_KB=1024
